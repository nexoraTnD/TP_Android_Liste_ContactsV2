<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:background="#F5F7FB" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Fiche contact" android:textSize="26sp" android:textStyle="bold" android:textColor="#1F2D45" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp"/>
    <ImageView android:id="@+id/detailPhoto" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center_horizontal" android:scaleType="centerCrop" android:contentDescription="Photo du contact" android:layout_marginBottom="10dp"/>
    <Button android:id="@+id/choosePhotoButton" android:text="Choisir une photo" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/takePhotoButton" android:text="Prendre une photo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/lastNameInput" android:hint="Nom *" android:inputType="textCapWords" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/firstNameInput" android:hint="Prénom *" android:inputType="textCapWords" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/phoneInput" android:hint="Téléphone *" android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/emailInput" android:hint="Adresse e-mail" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp">
      <Button android:id="@+id/callButton" android:text="Appeler" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
      <Button android:id="@+id/emailButton" android:text="Envoyer un e-mail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
      <Button android:id="@+id/saveButton" android:text="Enregistrer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
      <Button android:id="@+id/cancelButton" android:text="Annuler" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
 </LinearLayout>
</ScrollView>
